# AtomicYield Oracle Agent — Environment Variables
# ─────────────────────────────────────────────────

# Oracle keypair private key (base58-encoded).
# This must be the same keypair set as the StakingPool authority.
# Generate with: solana-keygen new --outfile oracle.json
# Then convert: cat oracle.json | node -e "const bs58=require('bs58');process.stdin.on('data',d=>console.log(bs58.encode(Buffer.from(JSON.parse(d)))))"
ORACLE_PRIVATE_KEY=your_base58_private_key_here

# Solana RPC endpoint (devnet)
RPC_URL=https://api.devnet.solana.com

# Program ID (deployed AtomicYield program)
PROGRAM_ID=GoaMsjPkq4o6NvCRduKMA4W7EcF5wWM8mXgZbLM65y9K

# Cron schedule (default: every day at 00:05 UTC)
CRON_SCHEDULE=5 0 * * *
